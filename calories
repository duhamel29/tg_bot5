#!/usr/bin/env python3
"""
Инвентаризация пространства Confluence Server/Data Center -> CSV.

Для каждой страницы: путь в дереве, дата изменения, автор, объём текста,
число дочерних страниц и флаги EMPTY / STALE / DRAFT / XXX.

Запуск:
    export CONFLUENCE_URL="https:
    export CONFLUENCE_TOKEN="<Personal Access Token>"   # Профиль -> Настройки -> Персональные токены
    python3 confluence_inventory.py SPACEKEY [--stale-days 365] [--out inventory.csv]

Нужна только стандартная библиотека Python 3.8+. Скрипт только читает (GET),
ничего не меняет. Токен берётся из переменной окружения, в коде его нет.
"""
import argparse
import csv
import html
import json
import os
import re
import sys
import urllib.parse
import urllib.request
from datetime import datetime, timezone

EMPTY_CHARS = 200  # меньше стольких символов текста = «пустая»


def get(url, token):
    req = urllib.request.Request(url, headers={
        "Authorization": f"Bearer {token}",
        "Accept": "application/json",
    })
    with urllib.request.urlopen(req, timeout=60) as r:
        return json.load(r)


def text_len(storage_html):
    # Макросы (оглавление, children, jira) не считаем текстом
    s = re.sub(r"<ac:structured-macro.*?</ac:structured-macro>", " ", storage_html or "", flags=re.S)
    s = re.sub(r"<[^>]+>", " ", s)
    s = html.unescape(s)
    return len(re.sub(r"\s+", " ", s).strip())


def fetch_pages(base, space, token):
    pages, start, limit = [], 0, 50
    while True:
        q = urllib.parse.urlencode({
            "spaceKey": space, "type": "page", "status": "current",
            "start": start, "limit": limit,
            "expand": "version,ancestors,body.storage",
        })
        data = get(f"{base}/rest/api/content?{q}", token)
        pages.extend(data.get("results", []))
        print(f"  загружено {len(pages)}", file=sys.stderr)
        if data.get("size", 0) < limit:
            return pages
        start += limit


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("space")
    ap.add_argument("--stale-days", type=int, default=365)
    ap.add_argument("--out", default="inventory.csv")
    a = ap.parse_args()

    base = os.environ.get("CONFLUENCE_URL", "").rstrip("/")
    token = os.environ.get("CONFLUENCE_TOKEN")
    if not base or not token:
        sys.exit("Задай CONFLUENCE_URL и CONFLUENCE_TOKEN")

    pages = fetch_pages(base, a.space, token)
    by_id = {p["id"]: p for p in pages}
    children = {}
    for p in pages:
        if p.get("ancestors"):
            parent = p["ancestors"][-1]["id"]
            children[parent] = children.get(parent, 0) + 1

    now = datetime.now(timezone.utc)
    rows = []
    for p in pages:
        when = datetime.fromisoformat(p["version"]["when"].replace("Z", "+00:00"))
        age = (now - when).days
        chars = text_len(p.get("body", {}).get("storage", {}).get("value"))
        kids = children.get(p["id"], 0)
        title = p["title"]
        flags = []
        if chars < EMPTY_CHARS and kids == 0:
            flags.append("EMPTY")
        elif chars < EMPTY_CHARS:
            flags.append("ONLY_CHILDREN")  # раздел-обёртка: норм, если это папка
        if age > a.stale_days:
            flags.append("STALE")
        if re.search(r"черновик|draft", title, re.I):
            flags.append("DRAFT")
        if "XXX" in title:
            flags.append("XXX")
        path = " / ".join(x["title"] for x in p.get("ancestors", []))
        rows.append({
            "flags": ",".join(flags),
            "title": title,
            "path": path,
            "depth": len(p.get("ancestors", [])),
            "last_modified": when.date().isoformat(),
            "days_since_edit": age,
            "last_editor": p["version"].get("by", {}).get("displayName", ""),
            "version": p["version"].get("number"),
            "text_chars": chars,
            "children": kids,
            "url": f"{base}/pages/viewpage.action?pageId={p['id']}",
            "action": "",  # заполнить: оставить / слить / перенести / архив / удалить
            "owner": "",
        })

    rows.sort(key=lambda r: (r["path"], r["title"]))
    with open(a.out, "w", newline="", encoding="utf-8-sig") as f:  # utf-8-sig — чтобы Excel открыл кириллицу
        w = csv.DictWriter(f, fieldnames=list(rows[0].keys()), delimiter=";")
        w.writeheader()
        w.writerows(rows)

    n = lambda flag: sum(flag in r["flags"].split(",") for r in rows)
    print(f"\nСтраниц: {len(rows)} | EMPTY: {n('EMPTY')} | STALE (>{a.stale_days} дн.): {n('STALE')} "
          f"| DRAFT: {n('DRAFT')} | XXX: {n('XXX')}\nCSV: {a.out}", file=sys.stderr)


if __name__ == "__main__":
    main()
